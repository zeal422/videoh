# Copy to .env.local and fill in both values.

# The access password — the thing you type at the gate. Human-chosen, at least
# 12 characters; quote it if it contains spaces.
GATE_PASSWORD=

# Independent random signing secret — machine-generated, never reused anywhere.
# Generate once:  openssl rand -base64 32
# Mixed into the session-cookie key so a stolen cookie cannot be used to
# brute-force the password offline. REQUIRED in production (the server refuses
# to boot without it); optional in local dev, which falls back with a warning.
GATE_SECRET=
